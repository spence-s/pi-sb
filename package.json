{
  "name": "pi-sb",
  "version": "0.0.2",
  "description": "A Pi extension that sandboxes shell and filesystem tools with configurable access.",
  "license": "MIT",
  "repository": "github:spence-s/pi-sb",
  "homepage": "https://github.com/spence-s/pi-sb",
  "bugs": "https://github.com/spence-s/pi-sb/issues",
  "author": "Spencer Snyder <sasnyde2@gmail.com> (https://spencersnyder.io)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "node --watch src/index.ts",
    "lint": "xo",
    "prepare": "node --input-type=module -e \"if (process.env.NODE_ENV !== 'production') (await import('husky')).default()\"",
    "release": "np",
    "start": "node dist/src/index.js",
    "test": "node --test test/**/*.test.ts",
    "test:coverage": "node --test --experimental-test-coverage test/**/*.test.ts",
    "test:watch": "node --test --watch test/**/*.test.ts",
    "update": "ncu -i",
    "prepack": "npm run build"
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "sandbox",
    "pi",
    "srt"
  ],
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.82",
    "execa": "^10.2.1",
    "object-deep-merge": "^2.0.1",
    "playwright": "^1.65.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@earendil-works/pi-tui": "^1.5.2",
    "@types/node": "^26.6.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "np": "^12.1.1",
    "npm-check-updates": "^23.1.1",
    "rimraf": "^6.1.4",
    "typebox": "^1.4.6",
    "typescript": "^6.0.3",
    "xo": "^5.0.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
